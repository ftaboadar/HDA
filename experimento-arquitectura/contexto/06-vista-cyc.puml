@startuml 06-vista-cyc

' Hogar de los Alpes (HdA) - Vista de Componentes y Conectores (runtime, Entrega 5)
'
' Fuente legible por agentes de la vista del equipo
' diagramas/entrega-5/04-vista-cyc-funcional.drawio (corregido el 2026-09-21 según
' 15-arquitectura-entrega-5.md §3). Aquí se muestra el sistema EN EJECUCIÓN tal como se
' despliega en GCP: procesos (Cloud Run api/worker), conectores (tópicos Pulsar con una
' suscripción por consumidor, cola Pub/Sub de Verificación, llamadas REST) y mecanismos
' de resiliencia (DLQ, reintento con backoff, throttler, circuit breaker).
' El recorrido de negocio paso a paso está en 15-arquitectura-entrega-5.md §5; el
' catálogo de tópicos en §7.
'
' Historial: versiones anteriores (Entregas 2-4) tenían ACL Pagos síncrono desde GT y a
' Pagos como externo; quedó en git.

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 11
skinparam component {
  BackgroundColor<<proceso>> #DAE8FC
  BorderColor<<proceso>> #6C8EBF
  BackgroundColor<<sensible>> #FFE6CC
  BorderColor<<sensible>> #D79B00
  BackgroundColor<<externo>> #F5F5F5
  BorderColor<<externo>> #666666
  BackgroundColor<<middleware>> #FFF2CC
  BorderColor<<middleware>> #D6B656
}
skinparam queue {
  BackgroundColor #EDEDED
  BorderColor #666666
}
skinparam database {
  BackgroundColor #DAE8FC
  BorderColor #6C8EBF
}

title Hogar de los Alpes — Vista C&C (runtime, Entrega 5)\nUn journey: proveedor habilitado → trabajo asignado → finalizado → pagado y calificado

actor "Dueño de hogar" as DUENO
actor "Proveedor" as PROV
actor "Partner B2B2C" as PARTNER
actor "Operador" as OPER

component "API Gateway / LB" as LB <<middleware>>

' ---------------- Canales ----------------
component "marketplace-api" as MKT_API <<proceso>>
component "marketplace-worker" as MKT_W <<proceso>>
database "BD Marketplace" as MKT_DB
component "siniestros-api\n⚠ SP6 pico 4x" as SIN_API <<sensible>>
component "siniestros-worker" as SIN_W <<proceso>>
database "BD Siniestros" as SIN_DB
component "suscripciones-api" as SUS_API <<proceso>>
component "suscripciones-worker" as SUS_W <<proceso>>
database "BD Suscripciones" as SUS_DB

' ---------------- Núcleo ----------------
component "gestion-trabajos-api\n⚠ SP1 réplicas + auto-scaling" as GT_API <<sensible>>
component "gestion-trabajos-worker\n(Ciclo de Vida · Motor)" as GT_W <<proceso>>
database "BD Trabajos" as GT_DB
queue "cola en memoria\nThrottler (token bucket)\n⚠ SP3" as THR
component "«Sidecar» Circuit Breaker\n+ timeout" as CB <<middleware>>

component "proveedores-api" as PRV_API <<proceso>>
component "proveedores-worker\n(Registro · Elegibilidad · Agenda)" as PRV_W <<proceso>>
component "verificacion-worker\n⚠ SP4 (push Pub/Sub)" as VER_W <<sensible>>
database "BD Proveedores" as PRV_DB
queue "Pub/Sub\nverificacion.solicitudes" as VQ
queue "Pub/Sub DLQ\nverificacion.fallidas" as VDLQ

component "pagos-api" as PAG_API <<proceso>>
component "pagos-worker\n(Liberación · Compensación)" as PAG_W <<proceso>>
database "BD Pagos" as PAG_DB

component "reputacion-api" as REP_API <<proceso>>
component "reputacion-worker" as REP_W <<proceso>>
database "Event Store Reputación" as REP_DB

component "scoring-api" as SCR_API <<proceso>>
component "scoring-worker" as SCR_W <<proceso>>
database "BD Scoring" as SCR_DB

' ---------------- Bus ----------------
queue "Apache Pulsar ⚠ SP5 (una suscripción Shared por consumidor)" {
  component "marketplace/solicitud.diagnosticada" as T_SOL
  component "siniestros/siniestro.aprobado" as T_SIN
  component "suscripciones/ciclo.suscripcion" as T_CIC
  component "gestion-trabajos/trabajo.creado" as T_CRE
  component "proveedores/elegibles.publicados" as T_ELE
  component "{marketplace,siniestros,suscripciones}/proveedor.seleccionado" as T_SEL
  component "proveedores/agenda.{confirmada,rechazada}" as T_AGE
  component "gestion-trabajos/novedad.registrada" as T_NREG
  component "siniestros/decision.partner" as T_DEC
  component "gestion-trabajos/trabajos.finalizado" as T_FIN
  component "gestion-trabajos/novedad.resuelta" as T_NOV
  component "pagos/pago.{retenido,retencion-fallida,liberado,fallido,compensado}" as T_PAG
  component "reputacion/reputacion.publicada" as T_REP
  component "scoring/scoring.actualizado" as T_SCR
  component "DLQ nativa por suscripción\n(fallos de consumo)" as T_DLQ <<sensible>>
}

' ---------------- Externos ----------------
component "Verificación externa\n(Policía · RUES · Certificadora 24-48h)" as X_VER <<externo>>
component "Pasarela (Stripe · MercadoPago)" as X_PAS <<externo>>
component "Gestión de Agentes (CRM SaaS)" as X_CRM <<externo>>
component "Notificaciones (Twilio)" as X_NOT <<externo>>
component "Gestor Documental (S3)" as X_DOC <<externo>>
component "ERP Contable" as X_ERP <<externo>>

' ===== Actores → API Gateway =====
DUENO --> LB
PROV --> LB
PARTNER --> LB
LB --> MKT_API : diagnosticar · cotizar ·\nseleccionar cotización
LB --> SIN_API : crear trabajo (partner) ·\naprobar paso · evidencias
LB --> SUS_API : contratar suscripción
LB --> PRV_API : registrar / verificar proveedor
LB --> GT_API : completar sub-trabajo ·\nreportar novedad · consultas
LB --> REP_API : calificar proveedor

' ===== Paso 0 — DISP-03 =====
PRV_API ..> VQ : publica solicitud\n(202, no espera al externo)
VQ ..> VER_W : push
VER_W --> X_VER : timeout + reintento\nbackoff exponencial + jitter
VER_W ..> VDLQ : reintentos agotados
OPER --> PRV_API : reprocesar DLQ (< 24h)
VER_W --> PRV_DB

' ===== Pasos 1-4 — creación, elegibles, selección =====
MKT_API ..> T_SOL
SIN_API ..> T_SIN
SUS_API ..> T_CIC
T_SOL ..> GT_W
T_SIN ..> GT_W
T_CIC ..> GT_W
GT_W ..> T_CRE
T_CRE ..> PRV_W
PRV_W ..> T_ELE
T_ELE ..> MKT_W : origen marketplace
T_ELE ..> SIN_W : origen siniestro\n(red permitida, monto máx.)
T_ELE ..> SUS_W : origen suscripción\n(primer ciclo)
MKT_API ..> T_SEL : el dueño elige
SIN_API ..> T_SEL : el partner aprueba
SUS_API ..> T_SEL : el cliente elige
T_SEL ..> PRV_W : reservar franja\n(atómico, agenda del técnico)
PRV_W ..> T_AGE
T_AGE ..> GT_W : confirmada → asignar
T_AGE ..> MKT_W : rechazada → re-seleccionar
T_AGE ..> SIN_W
T_AGE ..> SUS_W
T_AGE ..> REP_W : asignaciones
T_AGE ..> PAG_W : retener pago

' ===== Pasos 5-6 — cierre y fan-out (ESC-01) =====
GT_API ..> T_FIN : publicación async\n(no bloquea la aceptación)
GT_W ..> T_FIN
T_FIN ..> REP_W
T_FIN ..> SCR_W
T_FIN ..> PAG_W : origen mkt / suscripción
T_FIN ..> SIN_W : origen siniestro
T_FIN ..> PRV_W
T_FIN ..> SUS_W : MOD-03
T_FIN ..> T_DLQ : fallos de consumo

' ===== Pago (MOD-02) y cierre de la saga =====
PAG_W --> X_PAS : Strategy regional +\nAdapter de pasarela
PAG_W ..> T_PAG
T_PAG ..> GT_W : retenido → iniciar ·\nliberado → PAGADO · compensado
SIN_W --> X_ERP : facturar a partner

' ===== Reputación y Scoring =====
SCR_W ..> T_SCR
T_SCR ..> REP_W
REP_API ..> T_REP : tras calificar
T_REP ..> PRV_W : ranking de elegibles

' ===== Camino alterno — Novedades (DISP-02) =====
GT_W --> THR : EstadoTrabajoCambiado /\nnovedad reportada
THR --> X_CRM : dosifica, respeta Retry-After\n(≥99% < 15 min, 100% < 1 h)
X_CRM --> GT_API : webhook · novedad resuelta
GT_W ..> T_NREG : toda novedad
T_NREG ..> SIN_W : origen siniestro:\nReglaDeAprobacion
PARTNER --> SIN_API : aprobar / rechazar paso
SIN_W ..> T_DEC
SIN_API ..> T_DEC
T_DEC ..> GT_W : aplica la resolución\nsolo si APROBADA
GT_W ..> T_NOV : no-show / disputa / garantía
T_NOV ..> PAG_W : Compensar (disputa)
T_NOV ..> REP_W : cumplimiento y garantías

' ===== Circuit Breaker (solo Notificaciones / Documental) =====
GT_W --> CB
CB --> X_NOT : REST
CB --> X_DOC : REST / S3

' ===== Persistencia (BD por servicio) =====
MKT_API --> MKT_DB
SIN_API --> SIN_DB
SUS_API --> SUS_DB
GT_API --> GT_DB
GT_W --> GT_DB
PRV_API --> PRV_DB
PAG_W --> PAG_DB
PAG_API --> PAG_DB
REP_API --> REP_DB
REP_W --> REP_DB
SCR_W --> SCR_DB
SCR_API --> SCR_DB

note right of T_FIN
  **ESC-01**: un solo tópico particionado, una suscripción
  Shared por consumidor (6). El lag de uno no frena a los
  demás; cada worker escala por el lag de SU suscripción.
  Nombre plural conservado para no romper la evidencia previa.
end note

note left of VER_W
  **DISP-03**: la verificación es precondición de negocio:
  un proveedor con verificación en DLQ no aparece en
  ElegiblesPublicados hasta que el operador la reprocesa.
end note

legend right
  |= símbolo |= significado |
  | <back:#FFE6CC>  </back> | proceso o conector con punto de sensibilidad (SPn) |
  | <back:#DAE8FC>  </back> | proceso propio en Cloud Run (api = HTTP, worker = consumidor Pulsar + /salud) |
  | <back:#FFF2CC>  </back> | middleware (gateway, sidecar) |
  | <back:#F5F5F5>  </back> | sistema externo (mock en la PoC) |
  | ..> | asíncrono (Pulsar / Pub/Sub / cola en memoria) |
  | --> | síncrono (REST / BD) |
endlegend

@enduml
