@startuml 07-vista-informacion

' Hogar de los Alpes (HdA) - Vista de Información (TO-BE, Entrega 5)
'
' Fuente legible por agentes de la vista del equipo
' diagramas/entrega-5/02-vista-informacion.{png,svg} (Entidad-Relación, UML 2.5,
' agregaciones y referencias por ID). Un agregado (o más) por Bounded Context; entre
' agregados de contextos distintos solo hay referencias POR ID.
'
' Diferencias deliberadas con la imagen (ver 15-arquitectura-entrega-5.md, A8, y
' diagramas/entrega-5/CORRECCIONES.md):
'   - Cotización: en la imagen es entidad del agregado Trabajo. Aquí vive en Marketplace
'     (SolicitudTrabajo), que es el módulo que cotiza según las vistas de módulos y C&C;
'     el Trabajo guarda solo la cotización aceptada por ID + su Monto. [decidido, A8]
'   - Factura: en la imagen está dentro de la caja "Agregación Siniestro"; aquí es un
'     agregado propio del contexto Siniestros (módulo Facturación).
'   - Marketplace: la imagen no dibuja su agregado; se toma SolicitudTrabajo/Diagnostico
'     de la versión anterior de esta vista.
'
' Historial: versión anterior (Entregas 2-4) en git.

hide circle
hide empty members

skinparam class {
  BackgroundColor<<AggregateRoot>> #FFE6CC
  BorderColor<<AggregateRoot>> #D79B00
  BackgroundColor<<Entity>> #DAE8FC
  BorderColor<<Entity>> #6C8EBF
  BackgroundColor<<ValueObject>> #E1D5E7
  BorderColor<<ValueObject>> #9673A6
}

title Hogar de los Alpes — Vista de Información (TO-BE, Entrega 5)\nAgregados, entidades, objetos valor y referencias por ID

class Pais <<Entity>>

package "Gestión de Trabajos · Agregación Trabajo" {
  class Trabajo <<AggregateRoot>>
  class SubTrabajo <<Entity>>
  class Evidencia <<Entity>>
  class EstadoTrabajo <<ValueObject>>
  class Ubicacion <<ValueObject>>
  class Urgencia <<ValueObject>>
  class Categoria <<ValueObject>>
  class Monto <<ValueObject>>
  class Moneda <<ValueObject>>
  class Fecha <<ValueObject>>
  class TipoNovedad <<ValueObject>>

  Trabajo "1" *-- "1..*" SubTrabajo
  SubTrabajo ..> Trabajo : actualiza estado de
  SubTrabajo ..> SubTrabajo : bloquea a
  Trabajo "1" *-- "0..*" Evidencia : documenta
  Trabajo *-- EstadoTrabajo
  Trabajo *-- Ubicacion
  Trabajo *-- Urgencia
  Trabajo *-- Categoria
  Trabajo *-- Monto
  Trabajo *-- Fecha
  Monto *-- Moneda
}

package "Gestión de Trabajos · Agregación Novedad (A17)" {
  class Novedad <<AggregateRoot>>
  class EstadoNovedad <<ValueObject>>
  Novedad *-- TipoNovedad
  Novedad *-- EstadoNovedad
}

package "Marketplace · Agregación Solicitud" {
  class SolicitudTrabajo <<AggregateRoot>>
  class Diagnostico <<ValueObject>>
  class Cotizacion <<Entity>>

  SolicitudTrabajo *-- Diagnostico
  SolicitudTrabajo "1" *-- "0..*" Cotizacion : recibe
}

package "Proveedores · Agregación Proveedor" {
  class Proveedor <<AggregateRoot>>
  class ProveedorPersonaNatural <<Entity>>
  class ProveedorEmpresa <<Entity>>
  class Tecnico <<Entity>>
  class Verificacion <<Entity>>
  class Servicio <<Entity>>
  class DocumentoIdentidad <<ValueObject>>
  class NivelVerificacion <<ValueObject>>
  class ZonaCobertura <<ValueObject>>

  Proveedor <|-- ProveedorPersonaNatural
  Proveedor <|-- ProveedorEmpresa
  ProveedorEmpresa "1" *-- "0..*" Tecnico : emplea
  Proveedor "1" *-- "0..*" Verificacion : tiene
  Tecnico "1" *-- "0..*" Verificacion : tiene
  Proveedor "1" *-- "0..*" Servicio : ofrece
  Proveedor *-- ZonaCobertura : zona
  ProveedorPersonaNatural *-- DocumentoIdentidad : identificado por
  ProveedorEmpresa *-- DocumentoIdentidad : identificado por
  Verificacion *-- NivelVerificacion : nivel

  class AgendaTecnico <<AggregateRoot>>
  class Reserva <<Entity>>
  class Franja <<ValueObject>>

  AgendaTecnico "1" *-- "0..*" Reserva
  Reserva *-- Franja : fecha + bloque
}

package "Reputación · Agregación Reputación" {
  class PerfilDeReputacion <<AggregateRoot>>
  class Calificacion <<Entity>>
  class Puntaje <<ValueObject>>

  PerfilDeReputacion "1" *-- "0..*" Calificacion : acumula
  Calificacion *-- Puntaje
}

package "Scoring · Agregación Scoring" {
  class PerfilCrediticio <<AggregateRoot>>
  class PuntajeCrediticio <<ValueObject>>

  PerfilCrediticio *-- PuntajeCrediticio
}

package "Suscripciones · Agregación Suscripción" {
  class Suscripcion <<AggregateRoot>>
  class TipoServicioRecurrente <<ValueObject>>
  class Frecuencia <<ValueObject>>
  class EstadoSuscripcion <<ValueObject>>

  Suscripcion *-- TipoServicioRecurrente : tipo
  Suscripcion *-- Frecuencia
  Suscripcion *-- EstadoSuscripcion
}

package "Siniestros · Agregaciones Partner, Siniestro y Factura" {
  class Partner <<AggregateRoot>>
  class Aseguradora <<Entity>>
  class Banco <<Entity>>
  class Comercio <<Entity>>
  class ReglaDeAprobacion <<ValueObject>>
  class Siniestro <<AggregateRoot>>
  class DatosPoliza <<ValueObject>>
  class EvidenciaClimatica <<ValueObject>>
  class EstadoSiniestro <<ValueObject>>
  class Factura <<AggregateRoot>>
  class EstadoFactura <<ValueObject>>

  Partner <|-- Aseguradora
  Partner <|-- Banco
  Partner <|-- Comercio
  Partner *-- ReglaDeAprobacion : define
  Siniestro *-- DatosPoliza : póliza
  Siniestro *-- EvidenciaClimatica : evidencia
  Siniestro *-- EstadoSiniestro
  Factura *-- EstadoFactura
}

package "Pagos · Agregación Pago" {
  class Pago <<AggregateRoot>>
  class EstadoPago <<ValueObject>>
  note right of EstadoPago : RETENIDO → LIBERADO | COMPENSADO | FALLIDO (A18)

  Pago *-- EstadoPago
}

' --- Referencias entre agregados de distintos contextos (solo por ID) ---
Trabajo ..> Proveedor : asignado a (id)
Novedad ..> Trabajo : registrada en (id)
Trabajo ..> Cotizacion : cotización aceptada (id)
Trabajo ..> Pais : ubicado en (id)
Cotizacion ..> Proveedor : propuesta por (id)
SolicitudTrabajo ..> Trabajo : deriva en (id)
Siniestro ..> Trabajo : genera (id)
Siniestro ..> Partner : de (id)
Partner ..> Pais : opera en (id)
ReglaDeAprobacion ..> SubTrabajo : aprueba pasos de (id)
Suscripcion ..> Trabajo : genera (id)
Suscripcion ..> Proveedor : asignado a (id)
Factura ..> Comercio : facturado a (id)
Factura ..> Trabajo : factura (id)
Pago ..> Trabajo : genera (id)
Calificacion ..> Trabajo : califica (id)
PerfilDeReputacion ..> Proveedor : de (id)
PerfilCrediticio ..> Proveedor : de (id)
AgendaTecnico ..> Tecnico : agenda de (id)
Reserva ..> Trabajo : reservada para (id)
Reserva ..> Suscripcion : o para (id, recurrente)

note bottom of Pais
  País/región → Strategy ReglaRegional (MOD-02)
  y Moneda del Pago. El Pago la toma del Trabajo,
  no del request HTTP.
end note

legend right
  |= símbolo |= significado |
  | <back:#FFE6CC>  </back> | Raíz de agregado |
  | <back:#DAE8FC>  </back> | Entidad (parte del agregado) |
  | <back:#E1D5E7>  </back> | Objeto valor |
  | *-- | composición (pertenece al agregado) |
  | <\|-- | especialización |
  | ..> | referencia a otro agregado (solo por id) |
endlegend

@enduml
