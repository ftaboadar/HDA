@startuml 04-vista-contexto

' Hogar de los Alpes (HdA) - Vista de Contexto (TO-BE, Entrega 5)
'
' Fuente legible por agentes de la vista del equipo
' diagramas/entrega-5/01-vista-contexto.{png,svg} (HDA-002 v1.0, Ago 2026), con la
' decisión A1 de 15-arquitectura-entrega-5.md: Gestión de Pagos es un contexto PROPIO
' (dentro del límite del sistema) y la Pasarela de Pagos es el sistema EXTERNO.
' Solo se dibuja lo que cruza el límite del sistema (actor <-> servicio, servicio <-> externo).
' La coreografía interna entre servicios está en 05-vista-modulo.puml y 06-vista-cyc.puml.
'
' Historial: la versión anterior (Entregas 2-4) tenía "Pagos" como System_Ext; quedó en git.


!define RELATIVE_INCLUDE
!include ./C4-PlantUML/C4_Container.puml

AddElementTag("nuevo_e5", $bgColor="#d4edda", $fontColor="#155724", $borderColor="#28a745", $legendText="Nuevo / Cambiado en Entrega 5")


title Hogar de los Alpes (HdA) — Vista de Contexto (TO-BE, Entrega 5)

Person(duenoHogar, "Dueño de Hogar", "Solicita trabajos (Marketplace), califica al proveedor")
Person(proveedor, "Proveedor de Servicio", "Persona natural o empresa: se registra, cotiza, ejecuta")
Person(partner, "Partner B2B2C", "Aseguradora, banco o comercio")
Person(agente, "Agente de Gestión", "Atiende novedades y disputas en el CRM")

System_Boundary(hda, "HdA — Plataforma de Servicios (microservicios orientados a eventos)") {
  Container(bff, "API Gateway / BFF", "Microservicio · fachada", "Enruta peticiones de los actores a las APIs de dominio", $tags="nuevo_e5")
  Container(gestionTrabajos, "Gestión de Trabajos (Coordinador de Sagas)", "Microservicio · núcleo", "Orquestación de flujos mediante Saga Log; dueño del Trabajo (SP)", $tags="nuevo_e5")
  Container(proveedores, "Proveedores de Servicio", "Microservicio", "Registro, verificación y elegibilidad")
  Container(marketplace, "Marketplace", "Microservicio", "Diagnóstico, publicación y cotización")
  Container(reputacion, "Reputación y Calidad", "Microservicio", "Calificaciones")
  Container(siniestros, "Siniestros y Partners", "Microservicio", "Reglas y SLA por partner (SP)")
  Container(suscripciones, "Gestión de Suscripciones", "Microservicio", "Servicios recurrentes")
  Container(scoring, "Scoring y Crédito", "Microservicio", "Historial de trabajos → puntaje crediticio")
  Container(pagos, "Gestión de Pagos", "Microservicio", "Liberación y compensación; regla regional + adapter de pasarela")
  Container(ia, "IA Asistida", "Capacidad de soporte", "Diagnóstico y agentes reactivos (fuera de alcance E5)")
}

System_Ext(pasarela, "Pasarela de Pagos", "Stripe, MercadoPago — cobro y retención (SP)")
System_Ext(verificacion, "Verificación Externa", "Policía, RUES, certificadoras (SP)")
System_Ext(notificaciones, "Notificaciones", "SMS, email, push (Twilio)")
System_Ext(documental, "Gestor Documental", "Evidencias (S3 / CMS)")
System_Ext(erp, "ERP Contable", "Conciliación financiera")
System_Ext(crm, "Gestión de Agentes", "Coordinación humana (CRM SaaS)")

' --- Actores -> sistema ---
Rel(duenoHogar, bff, "Solicita, elige cotización")
Rel(duenoHogar, bff, "Califica")
Rel(duenoHogar, bff, "Contrata")
Rel(proveedor, bff, "Se registra")
Rel(proveedor, bff, "Cotiza")
Rel(proveedor, bff, "Reporta avance")
Rel(partner, bff, "Crea siniestro, aprueba pasos")
Rel(agente, crm, "Atiende tickets")


' --- BFF -> servicios internos ---
Rel(bff, marketplace, "Enruta")
Rel(bff, reputacion, "Enruta")
Rel(bff, suscripciones, "Enruta")
Rel(bff, proveedores, "Enruta")
Rel(bff, gestionTrabajos, "Enruta")
Rel(bff, siniestros, "Enruta")

' --- Sistema -> externos (síncrono, vía ACL/ADP) ---
Rel(pagos, pasarela, "Autoriza / captura")
Rel(proveedores, verificacion, "Verifica antecedentes")
Rel(gestionTrabajos, notificaciones, "Notifica")
Rel(gestionTrabajos, documental, "Evidencias")
Rel(gestionTrabajos, crm, "Novedades (throttled)")
Rel(siniestros, erp, "Asiento contable")

SHOW_LEGEND()

@enduml
