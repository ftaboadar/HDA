/*
 * Hogar de los Alpes (HdA)
 * Entrega 1 - Contextos Acotados TO-BE
 *
 * Migración a un sistema reactivo distribuido basado en eventos.
 * Se incluyen las capacidades genéricas (SaaS comprados) conectadas mediante Capas Anticorrupción (ACL).
 *
 * Revisión Entrega 5 (2026-09-21, ver 15-arquitectura-entrega-5.md §3, decisión A1):
 * ContextoPagos deja de ser un sistema externo comprado entero — HdA construye el
 * contexto Gestión de Pagos (liberación, compensación, regla regional) y compra solo
 * la pasarela (ContextoPasarelaDePagos: Stripe, MercadoPago). Las relaciones entre
 * contextos propios son eventos de integración sobre Apache Pulsar.
 */

import "./01-dominios-subdominios.cml"

BoundedContext ContextoGestionDeTrabajos implements GestionDeTrabajos {
  domainVisionStatement = "Contiene el Coordinador de Sagas (Motor de Workflow) y es dueño único del 'Trabajo'. Publica comandos y eventos (OHS/PL)."
}

BoundedContext ContextoMarketplace implements Marketplace {
  domainVisionStatement = "Dueño único del canal B2C. Publica intención de Trabajo hacia Gestión de Trabajos."
}

BoundedContext ContextoSuscripciones implements GestionDeSuscripciones {
  domainVisionStatement = "Dueño único del ciclo de vida de suscripciones. Contexto nuevo (greenfield)."
}

BoundedContext ContextoSiniestros implements SiniestrosYPartners {
  domainVisionStatement = "Dueño único del canal B2B2C: integraciones y reglas de partners."
}

BoundedContext ContextoProveedores implements ProveedoresDeServicio {
  domainVisionStatement = "Dueño único del registro y verificación. Publica eventos de habilitación."
}

BoundedContext ContextoReputacion implements ReputacionYCalidad {
  domainVisionStatement = "Calcula reputación consumiendo eventos de Gestión de Trabajos."
}

BoundedContext ContextoPagos implements Pagos {
  domainVisionStatement = "Gestión de Pagos propia de HdA: libera el pago de un trabajo finalizado aplicando la regla regional (Strategy) y la pasarela del país (Adapter), y compensa ante disputas. Publica el resultado a Gestión de Trabajos."
}

BoundedContext ContextoScoring implements ScoringYCredito {
  domainVisionStatement = "Calcula score crediticio. Expone API para originación de créditos."
}

/* --- Sistemas Genéricos Externos (Comprados/SaaS) --- */


BoundedContext ContextoBFF implements Marketplace {
  domainVisionStatement = "API Gateway / Backend For Frontend. Fachada única para clientes (dueños, proveedores, partners, operador). Sin estado ni lógica de dominio."
}

BoundedContext ContextoGestionAgentes implements OperacionDeAgentes {
  domainVisionStatement = "Plataforma SaaS (CRM) para los agentes humanos."
}

BoundedContext ContextoContabilidad implements Contabilidad {
  domainVisionStatement = "Sistema contable externo (ERP)."
}

BoundedContext ContextoGestorDocumental implements GestorDocumental {
  domainVisionStatement = "Repositorio documental externo."
}

BoundedContext ContextoNotificaciones implements Notificaciones {
  domainVisionStatement = "SaaS de notificaciones push, SMS y Email."
}

BoundedContext ContextoPasarelaDePagos implements Pagos {
  domainVisionStatement = "Pasarela de pagos externa para marketplace (ej. Stripe, MercadoPago): cobro, retención y payouts."
}

ContextMap HogarDeLosAlpesTOBE {
  type = SYSTEM_LANDSCAPE
  state = TO_BE

  contains ContextoGestionDeTrabajos
  contains ContextoMarketplace
  contains ContextoSiniestros
  contains ContextoSuscripciones
  contains ContextoProveedores
  contains ContextoReputacion
  contains ContextoScoring
  contains ContextoPagos
  
  /* Sistemas Genéricos */
  contains ContextoGestionAgentes
  contains ContextoContabilidad
  contains ContextoGestorDocumental
  contains ContextoNotificaciones
  contains ContextoPasarelaDePagos
  contains ContextoBFF

  
  /* Entrega 5: BFF como fachada de APIs síncronas */
  ContextoMarketplace [U, OHS, PL] -> [D, ACL] ContextoBFF { implementationTechnology = "API REST / gRPC" }
  ContextoSiniestros [U, OHS, PL] -> [D, ACL] ContextoBFF { implementationTechnology = "API REST / gRPC" }
  ContextoGestionDeTrabajos [U, OHS, PL] -> [D, ACL] ContextoBFF { implementationTechnology = "API REST / gRPC" }
  ContextoSuscripciones [U, OHS, PL] -> [D, ACL] ContextoBFF { implementationTechnology = "API REST / gRPC" }

  /* Relaciones Core -> Core (Basadas en Eventos) */
  ContextoMarketplace [U, OHS, PL] -> [D, ACL] ContextoGestionDeTrabajos { implementationTechnology = "Eventos de integración (Pulsar): SolicitudDiagnosticada, ProveedorSeleccionado" }
  ContextoSiniestros [U, OHS, PL] -> [D, ACL] ContextoGestionDeTrabajos { implementationTechnology = "Eventos de integración (Pulsar): SiniestroAprobado" }
  ContextoSuscripciones [U, OHS, PL] -> [D, ACL] ContextoGestionDeTrabajos { implementationTechnology = "Eventos de integración (Pulsar): CicloSuscripcion" }

  ContextoProveedores [U, OHS, PL] -> [D, ACL] ContextoMarketplace { implementationTechnology = "Eventos de integración (Pulsar): ElegiblesPublicados" }
  ContextoProveedores [U, OHS, PL] -> [D, ACL] ContextoSiniestros { implementationTechnology = "Eventos de integración" }
  ContextoProveedores [U, OHS, PL] -> [D, ACL] ContextoSuscripciones { implementationTechnology = "Eventos de integración" }

  ContextoGestionDeTrabajos [U, OHS, PL] -> [D, ACL] ContextoReputacion { implementationTechnology = "Eventos de integración (Pulsar): TrabajoFinalizado" }
  ContextoGestionDeTrabajos [U, OHS, PL] -> [D, ACL] ContextoScoring { implementationTechnology = "Eventos de integración (Pulsar): TrabajoFinalizado" }
  ContextoReputacion [U, OHS, PL] -> [D, ACL] ContextoMarketplace { implementationTechnology = "Eventos de integración" }

  /* Relaciones con Sistemas Genéricos Externos (Normalmente APIs / REST / ACL) */
  
  /* Gestión de agentes reacciona a los eventos de trabajos y proveedores para levantar tickets */
  ContextoGestionDeTrabajos [U, OHS, PL] -> [D, ACL] ContextoGestionAgentes { implementationTechnology = "Eventos -> Webhooks" }
  ContextoProveedores [U, OHS, PL] -> [D, ACL] ContextoGestionAgentes { implementationTechnology = "Eventos -> Webhooks" }

  /* Módulos Core consumen APIs externas de Notificaciones y Documentos mediante un ACL para no acoplarse al SDK */
  ContextoNotificaciones [U, OHS, PL] -> [D, ACL] ContextoGestionDeTrabajos { implementationTechnology = "API REST" }
  ContextoNotificaciones [U, OHS, PL] -> [D, ACL] ContextoMarketplace { implementationTechnology = "API REST" }
  
  ContextoGestorDocumental [U, OHS, PL] -> [D, ACL] ContextoGestionDeTrabajos { implementationTechnology = "API REST / S3" }
  ContextoGestorDocumental [U, OHS, PL] -> [D, ACL] ContextoProveedores { implementationTechnology = "API REST / S3" }

  /* Entrega 5: Gestión de Trabajos dispara la liberación del pago por evento y Pagos devuelve el resultado */
  ContextoGestionDeTrabajos [U, OHS, PL] -> [D, ACL] ContextoPagos { implementationTechnology = "Eventos de integración (Pulsar): TrabajoFinalizado, NovedadResuelta" }
  ContextoPagos [U, OHS, PL] -> [D, ACL] ContextoGestionDeTrabajos { implementationTechnology = "Eventos de integración (Pulsar): PagoLiberado, PagoFallido, PagoCompensado" }
  ContextoPasarelaDePagos [U, OHS, PL] -> [D, ACL] ContextoPagos { implementationTechnology = "API REST (Adapter por pasarela)" }

  /* Entrega 5: vueltas del journey entre contextos propios (ver 15-arquitectura-entrega-5.md §7) */
  ContextoGestionDeTrabajos [U, OHS, PL] -> [D, ACL] ContextoProveedores { implementationTechnology = "Eventos de integración (Pulsar): TrabajoCreado, TrabajoFinalizado" }
  ContextoProveedores [U, OHS, PL] -> [D, ACL] ContextoGestionDeTrabajos { implementationTechnology = "Eventos de integración (Pulsar): ElegiblesPublicados" }
  ContextoGestionDeTrabajos [U, OHS, PL] -> [D, ACL] ContextoSiniestros { implementationTechnology = "Eventos de integración (Pulsar): TrabajoFinalizado (facturar a partner)" }
  ContextoGestionDeTrabajos [U, OHS, PL] -> [D, ACL] ContextoSuscripciones { implementationTechnology = "Eventos de integración (Pulsar): TrabajoFinalizado" }
  ContextoScoring [U, OHS, PL] -> [D, ACL] ContextoReputacion { implementationTechnology = "Eventos de integración (Pulsar): ScoringActualizado" }
  ContextoReputacion [U, OHS, PL] -> [D, ACL] ContextoProveedores { implementationTechnology = "Eventos de integración (Pulsar): ReputacionPublicada" }

  /* La plataforma de pagos y el Scoring se sincronizan con la contabilidad formal */
  ContextoContabilidad [U, OHS, PL] -> [D, ACL] ContextoPagos { implementationTechnology = "Batch / API REST" }
  ContextoContabilidad [U, OHS, PL] -> [D, ACL] ContextoSiniestros { implementationTechnology = "Batch / API REST (asiento de facturación a partner)" }
  ContextoContabilidad [U, OHS, PL] -> [D, ACL] ContextoScoring { implementationTechnology = "Batch / API REST" }
}