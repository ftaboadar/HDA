    {
      "name": "4 - Recuperar y reprocesar",
      "description": "Equivalente a CP-6: la certificadora se recupera, se reprocesa manualmente la verificación que había caído en DLQ, y debe terminar COMPLETADA.",
      "item": [
        {
          "name": "Config Certificadora -> ok",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"modo\": \"ok\",\n  \"latencia_ms\": 300,\n  \"tasa_error\": 0.0\n}" },
            "url": { "raw": "{{mock_certificadora_url}}/_control/config", "host": ["{{mock_certificadora_url}}"], "path": ["_control", "config"] }
          },
          "response": []
        },
        {
          "name": "Reprocesar desde DLQ",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  pm.test('vuelve a PENDIENTE', () => pm.expect(pm.response.json().estado).to.eql('PENDIENTE'));",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{api_url}}/dlq/{{id_falla}}/reprocesar", "host": ["{{api_url}}"], "path": ["dlq", "{{id_falla}}", "reprocesar"] }
          },
          "response": []
        },
        {
          "name": "Consultar — debe terminar COMPLETADA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  pm.test('reproceso exitoso', () => pm.expect(data.estado).to.eql('COMPLETADA'));",
                  "  pm.test('reprocesos incrementado', () => pm.expect(data.reprocesos).to.be.above(0));",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{api_url}}/verificaciones/{{id_falla}}", "host": ["{{api_url}}"], "path": ["verificaciones", "{{id_falla}}"] }
          },
          "response": []
        }
      ]
