    {
      "name": "2 - Inyectar falla (certificadora caída)",
      "description": "Equivalente a CP-4: la certificadora se cae de forma dura y sostenida. Tras agotar reintentos (tenacity, backoff exponencial+jitter), el agregado transiciona a FALLIDA_DLQ y queda visible en /dlq con motivo trazado.",
      "item": [
        {
          "name": "Config Certificadora -> caído",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"modo\": \"caido\"\n}" },
            "url": { "raw": "{{mock_certificadora_url}}/_control/config", "host": ["{{mock_certificadora_url}}"], "path": ["_control", "config"] }
          },
          "response": []
        },
        {
          "name": "Crear verificación durante la caída",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  pm.environment.set('_poll_falla_intentos', '0');",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('id_falla', data.id);",
                  "  pm.test('202 aceptada igual (no bloquea)', () => pm.response.to.have.status(202));",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proveedor_id\": \"demo-falla-1\",\n  \"tipo_verificador\": \"certificadora\"\n}"
            },
            "url": { "raw": "{{api_url}}/verificaciones", "host": ["{{api_url}}"], "path": ["verificaciones"] }
          },
          "response": []
        },
        {
          "name": "Consultar verificación (repetir hasta ver FALLIDA_DLQ)",
          "description": "Si corrés esto a mano, apretá Send un par de veces hasta ver FALLIDA_DLQ (los reintentos con backoff tardan unos segundos). Si lo corrés con Collection Runner/Newman, este mismo request se reintenta solo hasta 10 veces via postman.setNextRequest — no hace falta intervención manual.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  const terminal = ['COMPLETADA', 'FALLIDA_DLQ'].includes(data.estado);",
                  "  if (terminal) {",
                  "    pm.test('llegó a estado terminal', () => pm.expect(terminal).to.be.true);",
                  "    return;",
                  "  }",
                  "  const intentos = parseInt(pm.environment.get('_poll_falla_intentos') || '0', 10);",
                  "  if (intentos < 10) {",
                  "    pm.environment.set('_poll_falla_intentos', String(intentos + 1));",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "  } else {",
                  "    pm.test('llegó a estado terminal (se agotaron los reintentos de polling)', () => pm.expect(terminal).to.be.true);",
                  "  }",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{api_url}}/verificaciones/{{id_falla}}", "host": ["{{api_url}}"], "path": ["verificaciones", "{{id_falla}}"] }
          },
          "response": []
        },
        {
          "name": "Ver DLQ",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  pm.test('la verificación fallida aparece en /dlq', () => {",
                  "    const ids = data.map(v => v.id);",
                  "    pm.expect(ids).to.include(pm.environment.get('id_falla'));",
                  "  });",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{api_url}}/dlq", "host": ["{{api_url}}"], "path": ["dlq"] }
          },
          "response": []
        }
      ]
    },
