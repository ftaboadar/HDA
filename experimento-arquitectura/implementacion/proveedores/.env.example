# Copiar a .env solo si se quiere correr algún servicio fuera de docker-compose
# (docker-compose.yml ya inyecta estas variables directamente).

TRANSPORTE=rabbitmq
DATABASE_URL=postgresql+psycopg2://hda:hda@localhost:5433/verificacion
RABBITMQ_URL=amqp://hda:hda@localhost:5672/
MOCK_POLICIA_URL=http://localhost:8101
MOCK_RUES_URL=http://localhost:8102
MOCK_CERTIFICADORA_URL=http://localhost:8103
MAX_REINTENTOS=4
TIMEOUT_EXTERNO_S=3.0
BACKOFF_BASE_S=0.5
BACKOFF_MAX_S=8.0

# --- Solo si TRANSPORTE=pulsar (ver app/common/pulsar_topology.py y sección 2.2
# del plan de Entrega 4) — requiere un cluster real de Apache Pulsar corriendo
# (implementacion/pulsar-infra/, propiedad de Daniel), no incluido en este
# docker-compose.yml. Los nombres de tópico por defecto ya están fijados en
# pulsar_topology.py, solo hace falta apuntar la URL del cluster:
# TRANSPORTE=pulsar
# PULSAR_SERVICE_URL=pulsar://localhost:6650
# PULSAR_ADMIN_URL=http://localhost:8080
# PULSAR_DLQ_BACKLOG_UMBRAL=50
# PULSAR_DLQ_CHECK_INTERVAL_S=30.0
