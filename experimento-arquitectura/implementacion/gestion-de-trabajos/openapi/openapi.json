  "info": {
    "title": "Gestión de Trabajos — API (Entrega 4 PoC, skeleton)",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/novedades": {
      "post": {
        "description": "202 Accepted, no 201 Created: la `Novedad` ya quedó persistida como\nPENDIENTE y encolada en el Throttler, pero su entrega real al CRM\n\"Gestión de Agentes\" es asíncrona (DISP-02) — el código de estado deja\nexplícito que la petición fue aceptada para proceso, no completada.",
        "operationId": "publicar_novedad_novedades_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovedadCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NovedadIdOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Publicar Novedad"
      }
    },
    "/novedades/{novedad_id}": {
      "get": {
        "description": "Agregado en esta tarea (DISP-02) — ver docstring de\n`application/queries/consultar_novedad.py`.",
        "operationId": "obtener_novedad_novedades__novedad_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "novedad_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Novedad Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NovedadOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Obtener Novedad"
      }
    },
    "/sagas/{saga_id}": {
      "get": {
        "operationId": "obtener_saga_sagas__saga_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "saga_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Saga Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Obtener Saga"
      }
    },
    "/salud": {
      "get": {
        "operationId": "salud_salud_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Salud"
      }
    },
    "/trabajos": {
      "post": {
        "operationId": "crear_trabajo_trabajos_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrabajoCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrabajoIdOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Crear Trabajo"
      }
    },
    "/trabajos/{trabajo_id}": {
      "get": {
        "operationId": "obtener_trabajo_trabajos__trabajo_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "trabajo_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Trabajo Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrabajoOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Obtener Trabajo"
      }
    },
    "/trabajos/{trabajo_id}/completar": {
      "post": {
        "description": "Paso 5 de la saga (§5.1 y §7.1 de 15-arquitectura-entrega-5.md):\n'Proveedor -API-> GT: CompletarSubTrabajo'. `202 Accepted` (no `200`):\nel efecto sobre el `Trabajo` (FINALIZADO) y el comando `LiberarPago` que\ndispara ocurren de forma asíncrona respecto a la saga -- misma\nconvención que `POST /novedades` (ver docstring de ese endpoint). Acepta\nun header `Idempotency-Key` opcional para reenvíos seguros del mismo\naviso del proveedor (si no llega, se genera un `id_mensaje` nuevo y la\nllamada NO es idempotente por sí sola; la protección real contra un\ndoble `finalizar()` la da igual el invariante del agregado `Trabajo`).",
        "operationId": "completar_sub_trabajo_trabajos__trabajo_id__completar_post",
        "parameters": [
          {
            "in": "path",
            "name": "trabajo_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Trabajo Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Completar Sub Trabajo"
      }
    }
  }
